<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="dotnetlegacy" value="https://devdiv.pkgs.visualstudio.com/OnlineServices/_packaging/dotnetlegacy/nuget/v3/index.json" />
    <!-- Vendored third-party build tools. No upstream sources. -->
    <add key="apisofdotnet-tools" value="https://pkgs.dev.azure.com/devdiv/OnlineServices/_packaging/apisofdotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <!-- Required by central package management (NU1507); also prevents dependency confusion. -->
  <packageSourceMapping>
    <packageSource key="dotnetlegacy">
      <package pattern="*" />
    </packageSource>
    <packageSource key="apisofdotnet-tools">
      <package pattern="ApisOfDotNet.GraphViz.Win32" />
    </packageSource>
  </packageSourceMapping>
</configuration>