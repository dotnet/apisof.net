<Project>

  <!--
    GraphViz ships with the app, but must not be downloaded from gitlab.com at build time -
    that violates 1ES Network Isolation (CFSClean2). Same binaries, vendored as a package by
    eng/Publish-GraphVizPackage.ps1.
  -->
  <ItemGroup>
    <PackageReference Include="ApisOfDotNet.GraphViz.Win32"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GetGraphVizFiles">
    <Error Condition="'$(PkgApisOfDotNet_GraphViz_Win32)' == ''"
           Text="The ApisOfDotNet.GraphViz.Win32 package was not restored, so GraphViz binaries are unavailable. Ensure the package is published to the 'apisofdotnet-tools' feed (see eng/Publish-GraphVizPackage.ps1)." />
    <ItemGroup>
      <GraphVizFile Include="$(PkgApisOfDotNet_GraphViz_Win32)\tools\Graphviz\**\*.*" />
    </ItemGroup>
    <Error Condition="'@(GraphVizFile)' == ''"
           Text="No GraphViz files found under '$(PkgApisOfDotNet_GraphViz_Win32)\tools\Graphviz'. The package layout is unexpected." />
  </Target>

  <Target Name="CopyGraphVizAfterBuild"
          DependsOnTargets="GetGraphVizFiles"
          AfterTargets="Build"
          Condition="!Exists('$(OutDir)\Graphviz')">
    <Message Importance="high" Text="GraphViz -> $(OutDir)\GraphViz" />
    <Copy SourceFiles="@(GraphVizFile)" DestinationFolder="$(OutDir)\GraphViz" />
  </Target>

  <Target Name="CopyGraphVizAfterPublish"
          DependsOnTargets="GetGraphVizFiles"
          AfterTargets="Publish"
          Condition="!Exists('$(PublishDir)\Graphviz')">
    <Message Importance="high" Text="GraphViz -> $(PublishDir)\GraphViz" />
    <Copy SourceFiles="@(GraphVizFile)" DestinationFolder="$(PublishDir)\GraphViz" />
  </Target>

  <Target Name="ExcludeLocalizationResources" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResourceCopyLocalItems Remove="@(ResourceCopyLocalItems)" />
    </ItemGroup>
  </Target>

</Project>
