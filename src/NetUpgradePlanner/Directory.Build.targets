<Project>

  <!--
    GraphViz ships with the app and is vendored under eng/graphviz rather than downloaded at
    build time - downloading from gitlab.com violates 1ES Network Isolation (CFSClean2).
    Run eng/Update-GraphViz.ps1 to refresh it for a new GraphViz release.
  -->
  <PropertyGroup>
    <GraphVizDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\eng\graphviz'))</GraphVizDir>
  </PropertyGroup>

  <Target Name="GetGraphVizFiles">
    <ItemGroup>
      <GraphVizFile Include="$(GraphVizDir)\**\*.*" />
    </ItemGroup>
    <Error Condition="'@(GraphVizFile)' == ''"
           Text="No GraphViz binaries found in '$(GraphVizDir)'. Run eng/Update-GraphViz.ps1 to restore them." />
  </Target>

  <Target Name="CopyGraphVizAfterBuild"
          DependsOnTargets="GetGraphVizFiles"
          AfterTargets="Build"
          Condition="!Exists('$(OutDir)\Graphviz')">
    <Message Importance="high" Text="GraphViz -> $(OutDir)\GraphViz" />
    <Copy SourceFiles="@(GraphVizFile)" DestinationFolder="$(OutDir)\GraphViz" />
  </Target>

  <Target Name="CopyGraphVizAfterPublish"
          DependsOnTargets="GetGraphVizFiles"
          AfterTargets="Publish"
          Condition="!Exists('$(PublishDir)\Graphviz')">
    <Message Importance="high" Text="GraphViz -> $(PublishDir)\GraphViz" />
    <Copy SourceFiles="@(GraphVizFile)" DestinationFolder="$(PublishDir)\GraphViz" />
  </Target>

  <Target Name="ExcludeLocalizationResources" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResourceCopyLocalItems Remove="@(ResourceCopyLocalItems)" />
    </ItemGroup>
  </Target>

</Project>
